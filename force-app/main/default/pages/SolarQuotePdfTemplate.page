<apex:page
    controller="SolarQuotePdfController"
    renderAs="pdf"
    applyHtmlTag="false"
    showHeader="false"
    sidebar="false"
    contentType="text/html;charset=UTF-8">

    <html>
        <head>
            <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

            <apex:stylesheet value="{!URLFOR($Resource.SolarQuotePdfStyles)}" />
        </head>

        <body>

            <table class="company-header" style="border:none; width:100%;">
                <tr>
                    <td style="border:none; padding:0; background:none; vertical-align:bottom;">

                        <div class="company-name">
                            SOLAR CORP HUNGARY
                        </div>

                        <div class="document-title">
                            MŰSZAKI ÉS PÉNZÜGYI ÁRAJÁNLAT
                        </div>

                    </td>

                    <td style="border:none; padding:0; background:none; text-align:right; vertical-align:bottom;">

                        <span style="font-size:9.5pt; color:#7f8c8d;">
                            Dátum:
                            {!DAY(TODAY())}.{!MONTH(TODAY())}.{!YEAR(TODAY())}.
                        </span>

                    </td>
                </tr>
            </table>

            <div class="section">
                <div class="body-text">

                    <apex:outputText
                        value="{!formattedQuoteBody}"
                        escape="false" />

                </div>
            </div>

        </body>
    </html>

</apex:page>