<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>Napelemes beruházási ajánlat</title>

    <style type="text/css">
        {{PDF_CSS}}
    </style>
</head>

<body>

    <table class="company-header" style="border:none; width:100%;">
        <tr>
            <td style="border:none; padding:0; background:none; vertical-align:bottom;">
                <div class="company-name">SOLAR CORP HUNGARY</div>
                <div class="document-title">
                    MŰSZAKI ÉS PÉNZÜGYI ÁRAJÁNLAT
                </div>
            </td>

            <td style="border:none; padding:0; background:none; text-align:right; vertical-align:bottom;">
                <span style="font-size:9.5pt; color:#7f8c8d;">
                    Dátum: {{DATE}}
                </span>
            </td>
        </tr>
    </table>

    <div class="section">
        <div class="body-text">
            {{QUOTE_BODY}}
        </div>
    </div>

</body>
</html>